# Copy to training/.env.local (git-ignored). DEV Supabase project only — never prod.
BASE_URL=http://localhost:3100
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEMO_AGENT_EMAIL=
DEMO_AGENT_PASSWORD=
# Which database is this? The tool refuses to run unless one of these is set.
# Preferred: the PROD project's URL — the seed refuses to run if SUPABASE_URL equals it.
PROD_SUPABASE_URL=
# Or: repeat the dev project's URL here, as a deliberate statement that SUPABASE_URL is dev.
CONFIRMED_DEV_SUPABASE_URL=

# Optional: a music file you hold a licence for. Mixed under the promo and faded out at the end.
PROMO_MUSIC=

# Optional: narration by ElevenLabs (`npm run promo:voice`). The key and the account are
# yours; the plan must allow commercial use. `npm run promo:voice -- --voices` lists voice ids.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_v4
